# Example environment variables for READ-IT
# Copy this to .env and fill in real values for local development

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/readit

# Security
SECRET_KEY=change_me_to_a_long_random_value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# CORS - comma separated list of allowed origins. Use * for all during development only.
ALLOWED_ORIGINS=http://localhost:3000

# Optional S3 or storage settings (if used)
# STORAGE_PROVIDER=local
# STORAGE_PATH=/data/uploads
